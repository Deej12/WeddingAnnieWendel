# Server settings
PORT=3000
ADMIN_KEY=your-admin-key-here

# Guest list validation file (place your Wedding Guest.xlsx in the data folder)
GUEST_LIST_FILE=data/Wedding Guest.xlsx

# SMTP email settings for sending notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
FROM_EMAIL=no-reply@annieandwendel.com
NOTIFY_EMAIL=annieandwendel@gmail.com
